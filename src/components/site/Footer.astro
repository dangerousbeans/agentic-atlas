---
import { href } from '../../lib/url';
import { author } from '../../lib/author';
import { contributingUrl } from '../../lib/contribute';
---
<footer class="site-footer">
  <div class="inner">
    <p class="brand"><span class="mark" aria-hidden="true"></span>Agentic Atlas</p>
    <p class="tag">A visual field guide to agentic AI patterns. Scripted traces, not live model runs.</p>
    <nav aria-label="Footer">
      <a href={href('/atlas/')}>Atlas</a>
      <a href={href('/families/')}>Families</a>
      <a href={href('/about/')}>About &amp; sources</a>
    </nav>
    <p class="credit">Made by {author.name}
      <a class="gh" href={author.github} rel="me" aria-label={`${author.name} on GitHub`}><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg></a>
      <span aria-hidden="true">·</span> <a href={author.repo}>Source</a>
      <span aria-hidden="true">·</span> <a href={contributingUrl()}>Contribute</a>
    </p>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); margin-top: 120px; color: var(--text-2); font-size: 14px; }
  .inner {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px 40px;
    padding: 32px var(--gutter) 40px;
    max-width: var(--max); margin: 0 auto;
  }
  p { margin: 0; }
  .brand {
    display: inline-flex; align-items: center; gap: 12px; color: var(--text);
    font: 800 12px/1 var(--font-display); font-stretch: 125%; letter-spacing: .12em; text-transform: uppercase;
  }
  .tag { font: 400 12px/1.5 var(--font-mono); color: var(--text-3); }
  .credit { grid-column: 1 / -1; font: 400 12px/1.5 var(--font-mono); letter-spacing: .04em; color: var(--text-3); display: flex; align-items: center; gap: 8px; }
  .credit a { color: var(--text-2); text-decoration: none; display: inline-flex; align-items: center; }
  .credit a:hover { color: var(--text); text-decoration: underline; text-decoration-color: var(--accent); }
  nav { display: flex; gap: 24px; }
  nav a { text-decoration: none; color: var(--text-2); }
  nav a:hover { color: var(--text); text-decoration: underline; text-decoration-color: var(--accent); }
  @media (max-width: 860px) { .inner { grid-template-columns: 1fr; } }
</style>
