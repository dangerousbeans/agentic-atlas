---
import { Code } from 'astro-expressive-code/components';
import type { CodeBlock } from '../../lib/diagram/types';
interface Props { uid: string; code: CodeBlock[]; prompts: CodeBlock[] }
const { uid, code, prompts } = Astro.props;
---
<section class="code-panel" data-code-panel data-uid={uid} aria-label="Setup">
  <div class="tabs" role="tablist" hidden>
    <button role="tab" type="button" aria-selected="true" aria-controls={`${uid}-pseudo`} id={`${uid}-tab-pseudo`}>Pseudocode</button>
    <button role="tab" type="button" aria-selected="false" aria-controls={`${uid}-prompts`} id={`${uid}-tab-prompts`} tabindex="-1">Prompts</button>
  </div>
  <div role="tabpanel" id={`${uid}-pseudo`} aria-labelledby={`${uid}-tab-pseudo`}>
    <h3 class="panel-h">Pseudocode</h3>
    {code.map(b => <div data-code-block={b.id}><Code code={b.source.replace(/\n$/, '')} lang={b.lang} title={b.title} /></div>)}
  </div>
  <div role="tabpanel" id={`${uid}-prompts`} aria-labelledby={`${uid}-tab-prompts`}>
    <h3 class="panel-h">Prompt templates</h3>
    {prompts.map(b => <div data-code-block={b.id}><Code code={b.source.replace(/\n$/, '')} lang={b.lang} title={b.title} wrap /></div>)}
  </div>
</section>
<script>
  for (const panel of document.querySelectorAll<HTMLElement>('[data-code-panel]')) {
    const tabs = [...panel.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panes = [...panel.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    panel.querySelector('[role="tablist"]')?.removeAttribute('hidden');
    panel.classList.add('is-enhanced');
    // Code can scroll sideways: let keyboard users reach it (axe: scrollable-region-focusable).
    panel.querySelectorAll('pre').forEach(pre => { pre.tabIndex = 0; });
    const select = (i: number) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panes.forEach((p, j) => (p.hidden = i !== j));
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', e => { if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { const n = (i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length; select(n); tabs[n].focus(); } });
    });
    select(0);
    const highlight = (ref?: { block: string; lines: string } | null) => {
      panel.querySelectorAll('.ec-line.is-step').forEach(l => l.classList.remove('is-step'));
      if (!ref) return;
      const [a, b = a] = ref.lines.split('-').map(Number);
      const lines = panel.querySelectorAll(`[data-code-block="${ref.block}"] .ec-line`);
      for (let i = a; i <= b; i++) lines[i - 1]?.classList.add('is-step');
    };
    const parse = (v: string | null | undefined) => {
      const [block, lines] = (v ?? '').split(':');
      return block && lines ? { block, lines } : null;
    };
    highlight(parse(document.querySelector(`flow-player[data-uid="${panel.dataset.uid}"]`)?.getAttribute('data-code-ref')));
    document.addEventListener('flowstep', e => {
      const d = (e as CustomEvent).detail as { uid: string; codeRef?: { block: string; lines: string } };
      if (d.uid === panel.dataset.uid) highlight(d.codeRef);
    });
  }
</script>
<style>
  .tabs[hidden] { display: none; }
  .tabs { display: flex; gap: 4px; margin-bottom: 12px; border-bottom: 1px solid var(--line); }
  .tabs button { background: none; border: 0; color: var(--text-2); font: 500 14px var(--font-ui); padding: 10px 14px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .tabs button[aria-selected="true"] { color: var(--text); border-bottom-color: var(--family-accent); }
  .code-panel.is-enhanced .panel-h { display: none; }
  .panel-h { font-size: 1.2rem; }
  [data-code-block] { margin-bottom: 16px; }
  :global(.ec-line) { transition: background-color .25s; }
  :global(.ec-line.is-step) { background: color-mix(in oklab, var(--family-accent) 16%, transparent); box-shadow: inset 2px 0 0 var(--family-accent); }
</style>
