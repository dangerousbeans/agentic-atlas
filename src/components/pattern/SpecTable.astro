---
import type { PatternStats } from '../../lib/pattern-stats';
interface Props { stats: PatternStats; badges: { autonomy: string; cost: string; latency: string } }
const { stats: s, badges: b } = Astro.props;
const yn = (v: boolean) => (v ? 'yes' : 'no');
const rows: [label: string, value: string, tip: string][] = [
  ['Nodes', String(s.nodes), 'Boxes in the diagram: models, tools, stores, people and plain code.'],
  ['LLM calls', String(s.llmCalls), 'Model invocations in the first scenario: each time a model or agent node starts thinking, plus each branch it decides.'],
  ['Tool calls', String(s.toolCalls), 'Messages sent to a tool node in the first scenario.'],
  ['Steps', String(s.steps), 'Steps in the first scenario, with repeated steps counted every time they run.'],
  ['Scenarios', String(s.scenarios), 'Distinct example runs you can switch between on the diagram.'],
  ['Loop', yn(s.loop), 'Whether the flow cycles back on itself until a condition is met.'],
  ['Parallel', yn(s.parallel), 'Whether two or more messages are in flight at the same time.'],
  ['Branch', yn(s.branch), 'Whether the flow takes one path out of several, chosen at run time.'],
  ['Human in the loop', yn(s.humanInLoop), 'Whether a person appears as a node, to approve, correct or answer.'],
  ['Autonomy', b.autonomy, 'How much the model decides the control flow itself, from fixed code paths (low) to open-ended (high).'],
  ['Cost', b.cost, 'Relative token spend per request.'],
  ['Latency', b.latency, 'Relative wall-clock time per request.'],
];
---
<section class="spec-section" aria-labelledby="spec-h">
  <h2 id="spec-h" class="spec-h"><span class="mark" aria-hidden="true"></span>Measured over one run</h2>
  <dl class="spec">
    {rows.map(([k, v, tip]) => (
      <div class="spec-row" tabindex="0" data-tip={tip}>
        <dt>{k}</dt><dd><span class="v">{v}</span><span class="sr-only">. {tip}</span></dd>
      </div>
    ))}
  </dl>
  <p class="spec-note">Counted from the first scenario's timeline when the site is built.</p>
</section>
<style>
  h2.spec-h { display: flex; align-items: center; gap: 10px; font: 600 11px/1.2 var(--font-ui); font-stretch: 100%; letter-spacing: .16em; text-transform: uppercase; color: var(--text-2); margin: 28px 0 10px; }
  .spec { position: relative; margin: 0; border-top: 1px solid var(--line); }
  .spec-row { position: relative; display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 7px 2px; border-bottom: 1px solid var(--line); cursor: help; }
  .spec-row:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .spec-row:hover { background: var(--bg-1); }
  dt { font: 400 14px/1.3 var(--font-ui); color: var(--text-2); }
  dd { margin: 0; font: 500 15px/1.3 var(--font-mono); font-variant-numeric: tabular-nums; color: var(--text); }
  /* CSS-only tooltip, the same rules as the diagram tooltip (WCAG 1.4.13): hoverable via a bridge, dismissible with Esc
     (page-keys.ts sets data-dismissed), persistent while hovered or focused. Anchored to the row and capped at its width,
     so it can never widen the page. */
  .spec-row::after { display: none; content: attr(data-tip); position: absolute; left: 0; top: calc(100% + 6px); z-index: 20; width: max-content; max-width: min(300px, 100%); padding: 10px 12px; border: 1px solid var(--line-strong); border-top: 2px solid var(--accent); background: var(--bg-1); box-shadow: 0 10px 34px rgba(0, 0, 0, .55); font: 400 13px/1.45 var(--font-ui); color: var(--text-2); text-transform: none; letter-spacing: 0; cursor: default; }
  .spec-row::before { display: none; content: ''; position: absolute; left: 0; top: 100%; width: min(300px, 100%); height: 8px; }
  .spec-row:not([data-dismissed]):hover::after, .spec-row:not([data-dismissed]):hover::before,
  .spec-row:not([data-dismissed]):focus-visible::after { display: block; }
  .spec-note { margin: 10px 0 0; font: 400 12px/1.4 var(--font-mono); color: var(--text-3); }
</style>
