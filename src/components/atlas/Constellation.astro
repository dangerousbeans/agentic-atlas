---
import ConstellationSvg from './ConstellationSvg.astro';
import { href } from '../../lib/url';
import type { ConstellationData } from '../../lib/constellation';
interface Props { data: ConstellationData; focus?: string; height?: number }
const { data, focus, height = 640 } = Astro.props;
---
<div class="constellation" style={`--h:${height}px`} data-focus={focus ?? ''} data-base={href('/')}>
  <div class="fallback"><ConstellationSvg data={data} focus={focus} uid={focus ?? 'all'} /></div>
  <div class="gl" aria-hidden="true"></div>
  <script type="application/json" set:html={JSON.stringify(data)} />
  <slot />
</div>
<script>
  const els = document.querySelectorAll<HTMLElement>('.constellation');
  let probed: boolean | undefined;
  const hasGl = () => {
    if (probed !== undefined) return probed;
    try {
      const gl = (document.createElement('canvas').getContext('webgl2') || document.createElement('canvas').getContext('webgl')) as WebGLRenderingContext | null;
      probed = !!gl;
      gl?.getExtension('WEBGL_lose_context')?.loseContext();
    } catch { probed = false; }
    return probed;
  };
  const ok = () => !(matchMedia('(prefers-reduced-motion: reduce)').matches || innerWidth < 720) && hasGl();
  els.forEach(el => {
    if (!ok()) return;
    const io = new IntersectionObserver(async ([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const data = JSON.parse(el.querySelector('script[type="application/json"]')!.textContent!);
      const { mount } = await import('./constellation-scene');
      mount(el.querySelector('.gl')!, data, { focus: el.dataset.focus || undefined, baseHref: el.dataset.base! });
      el.classList.add('is-gl');
    }, { rootMargin: '200px' });
    io.observe(el);
  });
</script>
<style>
  .constellation { position: relative; height: var(--h); overflow: hidden; }
  .fallback, .gl { position: absolute; inset: 0; }
  .constellation.is-gl .fallback { opacity: 0; pointer-events: none; }
  .constellation.is-gl .fallback :global(a) { pointer-events: none; }
  @media (max-width: 720px) { .constellation { height: min(var(--h), 420px); } }
</style>
