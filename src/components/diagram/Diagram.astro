---
import type { DiagramSpec } from '../../lib/diagram/types';
import { layoutDiagram } from '../../lib/diagram/layout';
import { compileDiagram } from '../../lib/diagram/compile';
import type { FrameSpec } from '../../lib/diagram/state';
import { spansPage } from '../../lib/diagram/fit';
import { KIND_LABEL, nodeDescription, edgeDescription, edgeTitle, nodeMap } from '../../lib/diagram/kinds';
import DiagramSvg from './DiagramSvg.astro';
import Frame from '../site/Frame.astro';
import './diagram.css';
interface Props { uid: string; spec: DiagramSpec; title: string; compact?: boolean }
const { uid, spec, title, compact = false } = Astro.props;
const wide = await layoutDiagram(spec, spec.direction ?? 'RIGHT', compact ? 'compact' : 'wide');
// Phones: top-to-bottom. (A left-to-right phone layout was never narrower for any pattern, so it is not offered.)
const narrow = compact ? null : await layoutDiagram(spec, 'DOWN', 'narrow');
const timelines = compileDiagram(spec);
// The player only needs what frameAt reads (prose, labels and scenarios live in the markup or the timelines). A
// compact tile plays its first scenario and shows no captions, so it ships just that timeline, without captions or per-step event copies (only the step buttons read those): pages
// with every pattern on them (home, families) carry one per pattern.
const frameSpec: FrameSpec = { nodes: spec.nodes.map(({ id, kind, hidden }) => (hidden ? { id, kind, hidden } : { id, kind })), edges: spec.edges.map(({ id, to }) => ({ id, to })) };
const shipped = compact ? [{ ...timelines[0], steps: timelines[0].steps.map(s => ({ ...s, caption: '', events: [] })) }] : timelines;
const payload = JSON.stringify({ spec: frameSpec, timelines: shipped }).replace(/</g, '\\u003c');
const labels = nodeMap(spec);
// Full diagrams sit in the viewfinder frame (Frame.astro). Only the stage is framed: tabs, caption, steps and parts
// follow below it, so the corner brackets never sit on the controls. Pages must not wrap Diagram in another Frame.
---
<flow-player data-uid={uid} compact={compact ? '' : undefined} data-wide={!compact && spansPage(wide.width) ? '' : undefined} class:list={['diagram', { 'diagram--compact': compact }]}>
  {compact ? (
    <div class="diagram-stage">
      <DiagramSvg uid={uid} spec={spec} layout={wide} variant="wide" title={title} compact />
    </div>
  ) : (
    <Frame class="diagram-frame">
      <div class="diagram-stage">
        <DiagramSvg uid={uid} spec={spec} layout={wide} variant="wide" title={title} />
        {narrow && <DiagramSvg uid={uid} spec={spec} layout={narrow} variant="narrow" title={title} />}
      </div>
    </Frame>
  )}
  {!compact && (
    <>
      {timelines.length > 1 && (
        <div class="fp-tabs" role="tablist" aria-label="Scenario" hidden>
          {spec.scenarios.map((s, i) => <button type="button" role="tab" id={`${uid}-tab-${s.id}`} aria-controls={`${uid}-panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-scenario-tab={i}>{s.label}</button>)}
        </div>
      )}
      <p class="fp-caption" aria-live="polite"></p>
      <details class="fp-steps" open>
        <summary>All steps</summary>
        {timelines.map((tl, si) => (
          <div class="fp-scenario-steps" data-scenario={tl.id} data-alt={si > 0 ? '' : undefined} id={`${uid}-panel-${tl.id}`} role={timelines.length > 1 ? 'tabpanel' : undefined} aria-labelledby={timelines.length > 1 ? `${uid}-tab-${tl.id}` : undefined}>
            {timelines.length > 1 && <p class="fp-scenario-title">{tl.label}</p>}
            <ol class="fp-captions" data-scenario={tl.id}>
              {tl.steps.map(st => <li><button type="button" data-step-index={st.index}>{st.caption}{st.iteration && <span class="iter"> (round {st.iteration.n} of {st.iteration.of})</span>}</button></li>)}
            </ol>
          </div>
        ))}
      </details>
      <details class="fp-parts">
        <summary>Parts of this pattern</summary>
        <dl>
          {spec.nodes.map(n => (
            <div class="part"><dt>{n.label} <span class="part-kind">{KIND_LABEL[n.kind]}</span></dt><dd>{nodeDescription(n)}</dd></div>
          ))}
          {spec.edges.map(e => (
            <div class="part"><dt>{edgeTitle(e, labels)}{e.label && <span class="part-kind">{e.label}</span>}</dt><dd>{edgeDescription(e, labels)}{e.example && <q class="part-ex">{e.example}</q>}</dd></div>
          ))}
        </dl>
      </details>
    </>
  )}
  <script type="application/json" data-diagram set:html={payload} />
</flow-player>
<script>import "./flow-player.ts";</script>
