---
import type { DiagramSpec } from '../../lib/diagram/types';
import { labelLines, shownLabelIds, type DiagramLayout } from '../../lib/diagram/layout';
import { KIND_LABEL, nodeDescription, edgeDescription, edgeTitle, nodeMap } from '../../lib/diagram/kinds';
import { MIN_LABEL_SCALE, MAX_SCALE } from '../../lib/diagram/fit';
import NodeShape from './NodeShape.astro';
interface Props { uid: string; spec: DiagramSpec; layout: DiagramLayout; variant: 'wide' | 'narrow'; title: string; compact?: boolean }
const { uid, spec, layout, variant, title, compact = false } = Astro.props;
const labels = nodeMap(spec);
const pid = `${uid}-${variant}`;
const hiddenIds = new Set(spec.nodes.filter(n => n.hidden).map(n => n.id));
const pending = (e: { from: string; to: string }) => hiddenIds.has(e.from) || hiddenIds.has(e.to);
// Edges that converge on one node with the same label (e.g. five "rate?" edges into an evaluator) show it once.
const shown = shownLabelIds(spec);
const labelled = spec.edges.filter(e => shown.has(e.id));
// Never blow a small diagram up past MAX_SCALE, never shrink labels below MIN_LABEL_SCALE (scroll instead; the wide
// layout only once the player has picked it, fit.ts). Narrow --w: natural size, the cap on a desktop stage.
const sizing = compact ? undefined : `--max-w:${Math.round(layout.width * MAX_SCALE)}px;--min-w:${Math.ceil(layout.width * MIN_LABEL_SCALE)}px` +
  (variant === 'narrow' ? `;--w:${layout.width}px` : '');
// Compact thumbnails sit inside a link whose heading names them, so they are decorative.
---
<svg class="diagram-svg" data-layout={variant} viewBox={`0 0 ${layout.width} ${layout.height}`} style={sizing}
  aria-hidden={compact ? 'true' : undefined} role={compact ? undefined : 'group'} aria-labelledby={compact ? undefined : `${pid}-t ${pid}-d`}>
  {!compact && <title id={`${pid}-t`}>{title} diagram</title>}
  {!compact && <desc id={`${pid}-d`}>{spec.nodes.map(n => n.label).join(', ')}. Step captions follow the diagram.</desc>}
  <defs>
    <marker id={`${pid}-arrow`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path class="arrow" d="M0,1 L9,5 L0,9 z" />
    </marker>
    <radialGradient id={`${pid}-halo`}><stop offset="0" class="halo-stop-a" /><stop offset="1" class="halo-stop-b" /></radialGradient>
    {/* the comet glow, pre-rendered: flow-player fills each token dot's glow circle with it instead of a live drop-shadow */}
    <radialGradient id={`${pid}-tglow`} class="token-glow"><stop offset="0" class="tglow-a" /><stop offset="0.3" class="tglow-b" /><stop offset="0.6" class="tglow-c" /><stop offset="1" class="tglow-d" /></radialGradient>
  </defs>
  <g class="groups">
    {Object.entries(layout.groups).map(([id, g]) => (
      <g class="group" data-group={id}><rect x={g.x} y={g.y} width={g.w} height={g.h} rx="0" />{!compact && <text x={g.x + 14} y={g.y + 20}>{g.label}</text>}</g>
    ))}
  </g>
  {/* Active-edge glow as a soft stroked underlay, not a filter: the comet rides the active edge, and a drop-shadow
      under it would be re-blurred on every frame (R11). */}
  <g class="edge-glows" aria-hidden="true">
    {spec.edges.map(e => <path class="edge-glow" data-edge={e.id} data-state="idle" d={layout.edges[e.id].d} data-from={e.from} data-to={e.to} />)}
  </g>
  <g class="edges">
    {spec.edges.map(e => (
      <path id={`${pid}-e-${e.id}`} class={`edge edge--${e.style ?? 'solid'}${pending(e) ? ' edge--pending' : ''}`} data-edge={e.id} data-state="idle" d={layout.edges[e.id].d} marker-end={`url(#${pid}-arrow)`} data-from={e.from} data-to={e.to} />
    ))}
    {!compact && labelled.map(e => (
      <text class={`edge-label edge-label--${e.style ?? 'solid'}${pending(e) ? ' edge--pending' : ''}`} data-edge={e.id} x={layout.edges[e.id].label.x} y={layout.edges[e.id].label.y} text-anchor={layout.edges[e.id].label.anchor} data-from={e.from} data-to={e.to} aria-hidden="true">{e.label}</text>
    ))}
    {!compact && spec.edges.map(e => (
      <path class="edge-hit" data-hit={e.id} d={layout.edges[e.id].d} data-tip-t={edgeTitle(e, labels)} data-tip-k={e.label} data-tip-d={edgeDescription(e, labels)} data-tip-x={e.example} />
    ))}
  </g>
  <g class="nodes">
    {spec.nodes.map(n => { const b = layout.nodes[n.id]; const lines = labelLines(n.label, variant); return (
      <g class="node" data-node={n.id} data-kind={n.kind} data-state={n.hidden ? 'hidden' : 'idle'} transform={`translate(${b.x},${b.y})`} style={`--halo:url(#${pid}-halo)`}
        {...(compact ? {} : { tabindex: n.hidden ? -1 : 0, role: 'img', 'aria-label': `${n.label}. ${nodeDescription(n)}`, 'data-tip-t': n.label, 'data-tip-k': KIND_LABEL[n.kind], 'data-tip-d': nodeDescription(n) })}>
        <NodeShape kind={n.kind} cx={b.w / 2} />
        {!compact && <text class="label" x={b.w / 2} y={62} text-anchor="middle">{lines.map((l, i) => <tspan x={b.w / 2} dy={i ? 12 : 0}>{l}</tspan>)}</text>}
        {!compact && n.sublabel && <text class="sublabel" x={b.w / 2} y={74 + 12 * (lines.length - 1)} text-anchor="middle">{n.sublabel}</text>}
      </g>
    ); })}
  </g>
  <g class="tokens" aria-hidden="true"></g>
</svg>
