---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroStage from '../components/home/HeroStage.astro';
import AtlasMap from '../components/atlas/AtlasMap.astro';
import { getCatalog } from '../lib/catalog';
import { href } from '../lib/url';
const cat = await getCatalog();
const n = cat.patterns.length, nf = cat.families.length;
---
<BaseLayout title="Agentic Atlas" description={`A visual field guide to agentic AI patterns: ${n} patterns in ${nf} families, each with a live diagram, pseudocode and prompt templates.`}>
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-copy">
      <h1 id="hero-h">An atlas of agentic patterns.</h1>
      <p class="lede">
        {n} ways to build with LLMs, from one augmented call to teams of agents. Each pattern runs live:
        watch prompts, tool calls and loops move through it, then open it for the <strong>pseudocode and prompts</strong>.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="#atlas">Open the atlas</a>
        <a class="btn" href={href('/families/')}>Browse families</a>
        <a class="btn" href={href('/patterns/augmented-llm/')} data-random-pattern>Show me a random pattern</a>
      </div>
    </div>
    <div class="hero-visual">
      <HeroStage />
    </div>
  </section>

  <section class="atlas" id="atlas" aria-labelledby="atlas-h">
    <div class="wrap atlas-head">
      <p class="eyebrow">{n} patterns · {nf} families</p>
      <h2 id="atlas-h">The atlas</h2>
      <p class="lede">
        Every pattern sits on an island with its family. Far out, the map reads as clusters; close up, each diagram runs live.
        <span class="hint hint-fine">Scroll over the map to zoom, drag to move, click a pattern to open it. With the map focused, the arrow keys walk from pattern to pattern and Enter opens one.</span>
        <span class="hint hint-touch">Pinch to zoom, drag to move, tap a pattern to open it.</span>
      </p>
    </div>
    <AtlasMap />
  </section>

  <section class="wrap browse" id="families" aria-label="Families">
    <a class="btn" href={href('/families/')}><span class="mark" aria-hidden="true"></span>Browse all families</a>
  </section>
</BaseLayout>
<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    max-width: var(--max); margin: 0 auto; min-height: calc(100svh - var(--header-h));
  }
  .hero-copy { padding: clamp(40px, 7vh, 88px) clamp(28px, 3.5vw, 56px) 64px var(--gutter); display: flex; flex-direction: column; justify-content: center; }
  .hero-copy h1 { margin: 0 0 28px; font-size: clamp(2.6rem, 5.4vw, 4.6rem); line-height: 0.98; }
  .lede { color: var(--text-2); font-size: 18px; line-height: 1.55; max-width: 34rem; margin: 0; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .hero-visual {
    border-left: 1px solid var(--line);
    padding: clamp(40px, 7vh, 88px) var(--gutter) 56px clamp(28px, 4vw, 64px);
    display: flex; flex-direction: column; justify-content: center; min-width: 0;
  }

  .atlas { border-top: 1px solid var(--line); scroll-margin-top: var(--header-h); }
  .atlas-head { padding-top: 64px; padding-bottom: 32px; }
  .atlas-head h2 { margin: 14px 0 16px; }
  .atlas-head .lede { max-width: 46rem; }
  .hint { display: block; margin-top: 8px; color: var(--text-3); font-size: 15px; }
  .hint-touch { display: none; }
  @media (hover: none) and (pointer: coarse) { .hint-fine { display: none; } .hint-touch { display: block; } }

  .browse { display: flex; justify-content: center; padding-top: 56px; padding-bottom: 88px; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .hero-visual { order: -1; border-left: 0; padding: 28px var(--gutter) 8px; }
    .hero-copy { padding: 28px var(--gutter) 56px; }
  }
  @media (max-width: 600px) {
    .lede { font-size: 16px; }
    .cta .btn { flex: 1 1 auto; }
    .atlas-head { padding-top: 44px; }
  }
</style>
