---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Diagram from '../../components/diagram/Diagram.astro';
import PatternHeader from '../../components/pattern/PatternHeader.astro';
import BuildPanel from '../../components/pattern/BuildPanel.astro';
import NodeRef from '../../components/pattern/NodeRef.astro';
import RelatedPatterns from '../../components/pattern/RelatedPatterns.astro';
import Sources from '../../components/pattern/Sources.astro';
import PatternNav from '../../components/pattern/PatternNav.astro';
import SpecTable from '../../components/pattern/SpecTable.astro';
import { patternStats } from '../../lib/pattern-stats';
import { author, patternSourceUrl } from '../../lib/author';
import { correctionUrl } from '../../lib/contribute';
import { getCatalog } from '../../lib/catalog';
import { getEntry, render } from 'astro:content';
import { resolveVariants } from '../../lib/variants';
import { originCitation } from '../../lib/origin';
import type { Origin } from '../../lib/schema';
export async function getStaticPaths() {
  const cat = await getCatalog();
  return cat.patterns.map(p => ({ params: { slug: p.slug } }));
}
const cat = await getCatalog();
const p = cat.bySlug.get(Astro.params.slug!)!;
const fam = cat.family(p.family);
const prose = await getEntry('patternProse', p.slug);
if (!prose) throw new Error(`Missing index.mdx for pattern ${p.slug}`);
const { Content } = await render(prose);
const index = cat.patterns.findIndex(x => x.slug === p.slug);
const prev = cat.patterns[index - 1];
const next = cat.patterns[index + 1];
const slugs = cat.patterns.map(x => x.slug);
const variants = resolveVariants(p);
const multi = variants.length > 1;
const uidOf = (v: (typeof variants)[number]) => (v.isDefault ? p.slug : `${p.slug}--${v.id}`);
// One header line per distinct origin; variants without their own share the pattern's.
const origins: { origin: Origin; ids: string[]; names: string[]; isDefault: boolean }[] = [];
for (const v of variants) {
  if (!v.origin) continue;
  const g = origins.find(o => o.origin === v.origin);
  if (g) { g.ids.push(v.id); g.names.push(v.name); g.isDefault ||= v.isDefault; }
  else origins.push({ origin: v.origin, ids: [v.id], names: [v.name], isDefault: v.isDefault });
}
const tables = variants.map(v => ({ id: v.id, name: v.name, isDefault: v.isDefault, stats: patternStats(v.diagram) }));
const ld = origins.length ? { '@context': 'https://schema.org', '@type': 'TechArticle', headline: p.name, description: p.summary, citation: origins.map(o => originCitation(o.origin)) } : undefined;
---
<BaseLayout title={p.name} description={p.summary} pagefind ld={ld}>
  <article class="wrap pattern" data-variants={multi ? '' : undefined}>
    <PatternNav index={index} total={cat.patterns.length} prev={prev} next={next} slugs={slugs} />
    <div class="instrument" data-fit-span="(min-width: 961px)">
      <div class="stage">
        {multi && (
          <div class="variant-tabs" role="tablist" aria-label={`${p.name} variants`} data-variant-tabs hidden>
            {variants.map((v, i) => <button type="button" role="tab" id={`vtab-${v.id}`} aria-controls={`vpanel-${v.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-variant-tab={v.id}>{v.name}</button>)}
          </div>
        )}
        {variants.map(v => (
          <section class="variant-pane" id={`vpanel-${v.id}`} data-variant-pane={v.id} data-for-variants={v.id} data-on={v.isDefault ? '' : undefined}>
            {multi && <h2 class="variant-h" id={`variant-${v.id}`}><span class="mark" aria-hidden="true"></span>{v.isDefault ? `${v.name} (default)` : v.name}</h2>}
            {v.summary && <p class="variant-summary">{v.summary}</p>}
            <Diagram uid={uidOf(v)} spec={v.diagram} title={v.isDefault ? p.name : `${p.name}: ${v.name}`} />
          </section>
        ))}
        <p class="legend mono" aria-label="Keyboard shortcuts"><span><kbd>←</kbd> <kbd>→</kbd> neighbours</span><span><kbd>esc</kbd> atlas</span></p>
      </div>
      <div class="info">
        <PatternHeader pattern={p} family={fam} origins={origins} />
        <SpecTable tables={tables} badges={p.badges} />
      </div>
    </div>
    <div class="body">
      <div class="prose"><Content components={{ NodeRef }} /></div>
      <div class="side"><BuildPanel pattern={p} variants={variants} /></div>
    </div>
    <RelatedPatterns pattern={p} catalog={cat} />
    <Sources sources={p.sources} />
    <p class="made mono" data-pagefind-ignore>From the Agentic Atlas by {author.name} · <a href={patternSourceUrl(p.slug)}>Edit on GitHub</a> · <a href={correctionUrl(p.slug, p.name)}>Suggest a correction</a></p>
  </article>
</BaseLayout>
{multi && <script>import '../../components/pattern/variant-tabs.ts';</script>}
<style>
  /* Variants (addendum §2): with JS only the active variant's blocks show; without it they stack with headings. */
  :global([data-variants-enhanced] [data-for-variants]:not([data-on])) { display: none; }
  :global([data-variants-enhanced]) .variant-h { display: none; }
  .variant-tabs { display: flex; flex-wrap: wrap; gap: 0; margin: 0 0 14px; border-bottom: 1px solid var(--line); }
  .variant-tabs[hidden] { display: none; }
  .variant-tabs button {
    background: none; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; padding: 9px 14px 8px; cursor: pointer;
    font: 500 12px/1.2 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--text-3);
  }
  .variant-tabs button:hover { color: var(--text); }
  .variant-tabs button[aria-selected="true"] { color: var(--text); border-bottom-color: var(--accent); }
  @media (max-width: 480px) { .variant-tabs button { padding-inline: 9px; letter-spacing: .04em; } }
  .variant-tabs button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .variant-pane + .variant-pane { margin-top: 36px; }
  :global([data-variants-enhanced]) .variant-pane + .variant-pane { margin-top: 0; }
  .variant-h { display: flex; align-items: center; gap: 10px; margin: 0 0 8px; font: 600 11px/1.2 var(--font-ui); letter-spacing: .16em; text-transform: uppercase; color: var(--text-2); }
  .variant-summary { margin: 0 0 12px; font: 400 14px/1.5 var(--font-ui); color: var(--text-2); max-width: 46rem; }
  .made { margin: 48px 0 0; font-size: 12px; letter-spacing: .04em; color: var(--text-3); }
  .made a { color: var(--text-2); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .made a:hover { color: var(--text); text-decoration: underline; text-decoration-color: var(--accent); }
  .instrument { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: clamp(28px, 3.5vw, 48px); align-items: start; margin-top: 18px; }
  .info { padding-top: 6px; }
  .stage { padding-bottom: 28px; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 14px 0 0; font-size: 12px; letter-spacing: .04em; color: var(--text-3); }
  kbd { font: 500 11px var(--font-mono); color: var(--text-2); border: 1px solid var(--line-strong); padding: 1px 6px; }
  .body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 48px; align-items: start; margin-top: 32px; }
  .side { position: sticky; top: 80px; padding-top: 2.4rem; max-height: calc(100vh - 100px); overflow: auto; }
  .prose { font-size: 17px; color: var(--text-2); max-width: 40rem; }
  .prose :global(strong) { color: var(--text); font-weight: 500; }
  .prose :global(li) { margin: 6px 0; }
  /* Diagrams too wide to read beside the info column (fit.ts spansPage) take the full width, once flow-player
     finds the wide layout reads at that width; the title and measurements move above them as a band. */
  @media (min-width: 961px) {
    .instrument:has(.variant-pane[data-on] flow-player[data-wide]:not([data-fit="narrow"])) { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .instrument:has(.variant-pane[data-on] flow-player[data-wide]:not([data-fit="narrow"])) :global(.diagram-stage) { padding-inline: 0; }
    .instrument:has(.variant-pane[data-on] flow-player[data-wide]:not([data-fit="narrow"])) .info { order: -1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 56px; align-items: start; }
    .instrument:has(.variant-pane[data-on] flow-player[data-wide]:not([data-fit="narrow"])) .info :global(.spec) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 28px; }
    .instrument:has(.variant-pane[data-on] flow-player[data-wide]:not([data-fit="narrow"])) .info :global(h2.spec-h) { margin-top: 14px; }
  }
  @media (max-width: 960px) {
    .instrument, .body { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; max-height: none; overflow: visible; }
  }
</style>
