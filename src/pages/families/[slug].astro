---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Constellation from '../../components/atlas/Constellation.astro';
import Diagram from '../../components/diagram/Diagram.astro';
import { getCatalog } from '../../lib/catalog';
import { buildConstellation } from '../../lib/constellation';
import { href } from '../../lib/url';
import type { DiagramSpec } from '../../lib/diagram/types';
export async function getStaticPaths() { const cat = await getCatalog(); return cat.families.map(f => ({ params: { slug: f.slug } })); }
const cat = await getCatalog();
const f = cat.family(Astro.params.slug!);
const data = buildConstellation(cat.families, cat.patternsOf);
const pats = cat.patternsOf(f.slug);
---
<BaseLayout title={f.name} description={f.description} pagefind>
  <section class="fam-hero">
    <Constellation data={data} focus={f.slug} height={420}>
      <div class="copy wrap"><p class="eyebrow">Family · {pats.length} patterns</p><h1><span data-pagefind-filter="family">{f.name}</span></h1><p class="lede">{f.description}</p></div>
    </Constellation>
  </section>
  <section class="wrap">
    <ul class="pattern-strip">
      {pats.map(p => (
        <li>
          <a href={href(`/patterns/${p.slug}/`)}>
            <Diagram uid={`thumb-${p.slug}`} spec={p.diagram as DiagramSpec} title={p.name} compact />
            <h2>{p.name}</h2>
            <p>{p.summary}</p>
          </a>
        </li>
      ))}
    </ul>
    <nav class="other" aria-label="Other families"><p class="eyebrow">Other families</p>{cat.families.filter(x => x.slug !== f.slug).map(x => <a href={href(`/families/${x.slug}/`)}>{x.name}</a>)}</nav>
  </section>
</BaseLayout>
<style>
  .copy { position: absolute; inset: auto 0 36px 0; z-index: 2; pointer-events: none; }
  .lede { color: var(--text-2); font-size: 18px; max-width: 40rem; }
  .pattern-strip { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-top: 40px; }
  .pattern-strip a { display: block; text-decoration: none; padding: 14px; border: 1px solid var(--line); border-radius: 0; background: var(--bg-1); height: 100%; }
  .pattern-strip a:hover { border-color: var(--line-strong); }
  /* Compact thumbnails have no DOWN variant; keep the wide layout visible in narrow cards (scaled to fit). */
  .pattern-strip :global(.diagram-svg[data-layout="wide"]) { display: block; }
  .pattern-strip h2 { font-size: 1.35rem; margin: 14px 0 4px; }
  .pattern-strip p { color: var(--text-2); font-size: 14px; margin: 0; }
  @media (max-width: 720px) {
    .fam-hero :global(.constellation) { height: auto; }
    .fam-hero :global(.constellation .fallback) { position: relative; inset: auto; height: 260px; order: 2; }
    .fam-hero :global(.constellation-svg) { transform: scale(1.2); transform-origin: 50% 50%; }
    .fam-hero :global(.constellation) { display: flex; flex-direction: column; }
    .copy { position: relative; inset: auto; order: 1; padding-top: 32px; }
  }
  .other { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; margin-top: 64px; }
  .other a { color: var(--text); }
</style>
