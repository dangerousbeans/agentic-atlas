---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PatternCard from '../../components/site/PatternCard.astro';
import { getCatalog } from '../../lib/catalog';
import { href } from '../../lib/url';
export async function getStaticPaths() { const cat = await getCatalog(); return cat.families.map(f => ({ params: { slug: f.slug } })); }
const cat = await getCatalog();
const f = cat.family(Astro.params.slug!);
const pats = cat.patternsOf(f.slug);
---
<BaseLayout title={f.name} description={f.description} pagefind>
  <div class="wrap page">
    <header class="intro">
      <p class="count">{pats.length} patterns</p>
      <h1 class="display"><span data-pagefind-filter="family">{f.name}</span></h1>
      <p class="lede">{f.description}</p>
    </header>
    <h2 class="sr-only">Patterns in {f.name}</h2>
    <div class="grid">{pats.map(p => <PatternCard pattern={p} family={f} />)}</div>
    <nav class="other" aria-label="Other families">
      <p class="eyebrow">Other families</p>
      <ul>{cat.families.filter(x => x.slug !== f.slug).map(x => <li><a href={href(`/families/${x.slug}/`)}>{x.name}</a></li>)}</ul>
    </nav>
  </div>
</BaseLayout>
<style>
  .page { padding-top: 56px; padding-bottom: 96px; }
  .count { margin: 0 0 14px; font: 500 12px/1.4 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--text-2); }
  .intro h1 { margin: 0 0 20px; font-size: clamp(2rem, 5.5vw, 3.6rem); line-height: 1.05; }
  .lede { color: var(--text-2); font-size: 18px; line-height: 1.6; max-width: 40rem; margin: 0 0 48px; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 16px; }
  .other { margin-top: 72px; }
  .other ul { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .other a { color: var(--text); display: inline-flex; min-height: 44px; align-items: center; }
</style>
