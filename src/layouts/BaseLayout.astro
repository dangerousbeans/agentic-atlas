---
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { href } from '../lib/url';
import { author } from '../lib/author';
// Preload the two Latin faces every page paints with, so text doesn't wait for CSS to discover them.
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
/** `accent` is accepted for compatibility but ignored: the accent is always var(--accent). */
interface Props { title: string; description: string; accent?: string; pagefind?: boolean }
const { title, description, pagefind = false } = Astro.props;
const fullTitle = title === 'Agentic Atlas' ? title : `${title} · Agentic Atlas`;
const SITE_DESCRIPTION = 'A visual field guide to agentic AI patterns, each with a live diagram, pseudocode and prompt templates.';
const ld = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Agentic Atlas', description: SITE_DESCRIPTION, ...(Astro.site && { url: new URL(href('/'), Astro.site).toString() }), author: { '@type': 'Person', name: author.name, url: author.github, sameAs: [author.github] } }).replace(/</g, '\\u003c');
const og = Astro.site ? new URL(href('/og.png'), Astro.site).toString() : href('/og.png');
// Canonical URL: site + base + this page's path (Astro.url.pathname may or may not carry the base, so strip it first).
// The 404 page names no canonical page.
const baseNoSlash = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const ownPath = baseNoSlash && Astro.url.pathname.startsWith(baseNoSlash + '/') ? Astro.url.pathname.slice(baseNoSlash.length) : Astro.url.pathname;
const pagePath = ownPath.endsWith('/') ? ownPath : `${ownPath.replace(/(\/index)?\.html$/, '')}/`;
const canonical = Astro.site && !/^\/404\/?$/.test(pagePath) ? new URL(href(pagePath), Astro.site).toString() : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:site_name" content="Agentic Atlas" />
    <meta name="author" content={author.name} />
    <link rel="me" href={author.github} />
    <script type="application/ld+json" set:html={ld} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-pagefind-body={pagefind ? '' : undefined}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
